{
  "name": "neko-desk",
  "version": "2.2.9",
  "description": "cat desk app",
  "main": "main.js",
  "author": "Siwon",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --enable-logging",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux",
    "release": "electron-builder --win --publish always",
    "appx:assets": "node scripts/make-appx-assets.js",
    "build:store": "electron-builder --win nsis --publish never --config.extraMetadata.storeBuild=true --config.win.artifactName=NEKO-DESK-Store-${version}.${ext}",
    "build:msix": "electron-builder --win appx --publish never --config electron-builder.config.js --config.extraMetadata.storeBuild=true",
    "build:msix:test": "electron-builder --win appx --publish never --config electron-builder.config.js --config.extraMetadata.storeBuild=true --config.appx.publisher=\"CN=NEKO DESK Test\""
  },
  "dependencies": {
    "electron-updater": "^6.3.0"
  },
  "devDependencies": {
    "electron": "^36.0.0",
    "electron-builder": "^25.0.0",
    "jimp": "^0.22.12"
  },
  "build": {
    "appId": "com.siwon.nekodesk",
    "productName": "NEKO DESK",
    "copyright": "2026 Siwon",
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "main.js",
      "preload.js",
      "config.js",
      "renderer/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "artifactName": "NEKO-DESK-Setup-${version}.${ext}"
    },
    "appx": {
      "identityName": "NekoDesk.NEKODESK",
      "publisher": "CN=970F98AC-B684-4E05-8E19-353A4FEC7D68",
      "publisherDisplayName": "NekoDesk",
      "applicationId": "NEKODESK",
      "displayName": "NEKO DESK",
      "backgroundColor": "#2b2b2b",
      "languages": [
        "ko-KR",
        "en-US",
        "ja-JP"
      ],
      "customExtensionsPath": "assets/appx-extensions.xml",
      "addAutoLaunchExtension": false,
      "showNameOnTiles": false,
      "setBuildNumber": false,
      "artifactName": "NEKO-DESK-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "NEKO DESK"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "assets/icon-mac.png",
      "category": "public.app-category.productivity",
      "artifactName": "NEKO-DESK-${version}-${arch}.${ext}",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "assets/entitlements.mac.plist",
      "entitlementsInherit": "assets/entitlements.mac.inherit.plist",
      "notarize": false,
      "extendInfo": {
        "NSCameraUsageDescription": "고양이와 사진을 찍을 때 카메라를 사용합니다."
      }
    },
    "linux": {
      "target": "AppImage",
      "icon": "assets/icon.png",
      "category": "Utility"
    },
    "publish": {
      "provider": "github",
      "owner": "NekoDesk",
      "repo": "neko-desk"
    }
  }
}
