<?xml version="1.0" encoding="utf-8"?>
<!-- 시간표 한 조각. 좌우를 1dp 띄워 칸끼리 붙지 않게 한다. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:left="1dp" android:right="1dp" android:top="0dp" android:bottom="-6dp">
        <shape android:shape="rectangle">
            <solid android:color="#E4F5EC" />
            <stroke android:width="1dp" android:color="#A2D0BA" />
            <corners android:topLeftRadius="3dp" android:topRightRadius="3dp"
                android:bottomLeftRadius="0dp" android:bottomRightRadius="0dp" />
        </shape>
    </item>
</layer-list>
