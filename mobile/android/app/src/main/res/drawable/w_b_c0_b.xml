<?xml version="1.0" encoding="utf-8"?>
<!-- 시간표 한 조각. 좌우를 1dp 띄워 칸끼리 붙지 않게 한다. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:left="1dp" android:right="1dp" android:top="-6dp" android:bottom="0dp">
        <shape android:shape="rectangle">
            <solid android:color="#EDF0F5" />
            <stroke android:width="1dp" android:color="#A2AEC2" />
            <corners android:topLeftRadius="0dp" android:topRightRadius="0dp"
                android:bottomLeftRadius="3dp" android:bottomRightRadius="3dp" />
        </shape>
    </item>
</layer-list>
