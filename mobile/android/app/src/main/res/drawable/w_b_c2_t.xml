<?xml version="1.0" encoding="utf-8"?>
<!-- 시간표 한 조각. 좌우는 늘 테두리, 위아래는 위. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:left="1dp" android:right="1dp">
        <shape android:shape="rectangle">
            <solid android:color="#E2A8C0" />
            <corners android:topLeftRadius="3dp" android:topRightRadius="3dp" android:bottomLeftRadius="0dp" android:bottomRightRadius="0dp" />
        </shape>
    </item>
    <item android:left="2dp" android:right="2dp" android:top="1dp" android:bottom="0dp">
        <shape android:shape="rectangle">
            <solid android:color="#FBE7EF" />
            <corners android:topLeftRadius="2dp" android:topRightRadius="2dp" android:bottomLeftRadius="0dp" android:bottomRightRadius="0dp" />
        </shape>
    </item>
</layer-list>
