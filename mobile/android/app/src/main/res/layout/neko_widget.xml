<?xml version="1.0" encoding="utf-8"?>
<!--
  홈 화면 위젯.
  줄 수가 정해지지 않은 부분(D-day, 오늘 할 일, 어제·내일)은 빈 칸만 두고
  코드에서 개수만큼 붙인다. RemoteViews가 다루는 뷰만 쓴다.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/w_bg"
    android:padding="10dp">

    <include layout="@layout/w_header" />
    <include layout="@layout/w_health" />

    <!-- D-day — 등록된 만큼 전부 -->
    <LinearLayout
        android:id="@+id/w_dday_list"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="3dp" />

    <!-- 오늘 할 일 머리글 -->
    <LinearLayout
        android:id="@+id/w_head_box"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingLeft="3dp"
        android:paddingRight="4dp"
        android:paddingTop="3dp"
        android:layout_marginBottom="6dp">

        <TextView android:id="@+id/w_head_title"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:textSize="12sp" android:textColor="#3E3A39"
            android:maxLines="1" android:ellipsize="end" android:text="" />

        <TextView android:id="@+id/w_head_count"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textSize="10sp" android:textColor="#9AA0A6" android:text="" />
    </LinearLayout>

    <!-- 오늘 할 일 -->
    <LinearLayout
        android:id="@+id/w_today_list"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />

    <TextView
        android:id="@+id/w_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:textSize="11sp"
        android:textColor="#9AA0A6"
        android:text="" />

    <!-- 어제 · 내일 -->
    <LinearLayout
        android:id="@+id/w_sides"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="5dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:background="@drawable/w_side_bg"
            android:paddingLeft="9dp"
            android:paddingRight="9dp"
            android:paddingTop="7dp"
            android:paddingBottom="7dp">

            <TextView android:id="@+id/w_yday_title"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textSize="10sp" android:textColor="#9AA0A6"
                android:paddingBottom="3dp"
                android:maxLines="1" android:ellipsize="end" android:text="" />

            <LinearLayout android:id="@+id/w_yday_list"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView android:id="@+id/w_yday_empty"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textSize="10sp" android:textColor="#BDC1C6"
                android:paddingTop="2dp" android:text="" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:background="@drawable/w_side_bg"
            android:paddingLeft="9dp"
            android:paddingRight="9dp"
            android:paddingTop="7dp"
            android:paddingBottom="7dp"
        android:layout_marginStart="6dp">

            <TextView android:id="@+id/w_tmr_title"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textSize="10sp" android:textColor="#9AA0A6"
                android:paddingBottom="3dp"
                android:maxLines="1" android:ellipsize="end" android:text="" />

            <LinearLayout android:id="@+id/w_tmr_list"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView android:id="@+id/w_tmr_empty"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textSize="10sp" android:textColor="#BDC1C6"
                android:paddingTop="2dp" android:text="" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
