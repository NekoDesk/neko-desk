<?xml version="1.0" encoding="utf-8"?>
<!-- 홈 화면 위젯. RemoteViews는 쓸 수 있는 뷰가 제한적이라 단순한 구조로 만든다. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/w_bg"
    android:padding="14dp">

    <!-- D-day -->
    <LinearLayout
        android:id="@+id/w_dday_box"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="10dp">

        <TextView
            android:id="@+id/w_dday_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textSize="13sp"
            android:textColor="#4a4a4a"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="" />

        <TextView
            android:id="@+id/w_dday_badge"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#d9736e"
            android:text="" />

        <TextView
            android:id="@+id/w_dday_date"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textSize="10sp"
            android:textColor="#9a9a9a"
            android:text="" />
    </LinearLayout>

    <!-- 가름선. RemoteViews가 확실히 다루는 ImageView로 그린다 -->
    <ImageView
        android:id="@+id/w_div"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#e2e2e2"
        android:contentDescription="@null"
        android:layout_marginBottom="8dp" />

    <!-- 오늘 할 일 -->
    <LinearLayout android:id="@+id/w_row1" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:orientation="horizontal"
        android:paddingBottom="5dp">
        <ImageView android:id="@+id/w_dot1" android:layout_width="14dp" android:layout_height="14dp"
            android:layout_marginEnd="8dp" android:layout_gravity="center_vertical"
            android:src="@drawable/w_check_off" />
        <TextView android:id="@+id/w_todo1" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textSize="12sp" android:textColor="#4a4a4a"
            android:maxLines="1" android:ellipsize="end" android:text="" />
    </LinearLayout>

    <LinearLayout android:id="@+id/w_row2" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:orientation="horizontal"
        android:paddingBottom="5dp">
        <ImageView android:id="@+id/w_dot2" android:layout_width="14dp" android:layout_height="14dp"
            android:layout_marginEnd="8dp" android:layout_gravity="center_vertical"
            android:src="@drawable/w_check_off" />
        <TextView android:id="@+id/w_todo2" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textSize="12sp" android:textColor="#4a4a4a"
            android:maxLines="1" android:ellipsize="end" android:text="" />
    </LinearLayout>

    <LinearLayout android:id="@+id/w_row3" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:orientation="horizontal"
        android:paddingBottom="5dp">
        <ImageView android:id="@+id/w_dot3" android:layout_width="14dp" android:layout_height="14dp"
            android:layout_marginEnd="8dp" android:layout_gravity="center_vertical"
            android:src="@drawable/w_check_off" />
        <TextView android:id="@+id/w_todo3" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textSize="12sp" android:textColor="#4a4a4a"
            android:maxLines="1" android:ellipsize="end" android:text="" />
    </LinearLayout>

    <LinearLayout android:id="@+id/w_row4" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:orientation="horizontal">
        <ImageView android:id="@+id/w_dot4" android:layout_width="14dp" android:layout_height="14dp"
            android:layout_marginEnd="8dp" android:layout_gravity="center_vertical"
            android:src="@drawable/w_check_off" />
        <TextView android:id="@+id/w_todo4" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textSize="12sp" android:textColor="#4a4a4a"
            android:maxLines="1" android:ellipsize="end" android:text="" />
    </LinearLayout>

    <TextView
        android:id="@+id/w_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingTop="10dp"
        android:textSize="11sp"
        android:textColor="#9a9a9a"
        android:text="앱을 열어 일정을 등록해 보세요" />
</LinearLayout>
