<?xml version="1.0" encoding="utf-8"?>
<!-- 위젯 맨 위 — 고양이와 앱 이름 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:layout_marginBottom="8dp">

    <ImageView android:id="@+id/w_cat"
        android:layout_width="26dp" android:layout_height="26dp"
        android:layout_marginEnd="8dp"
        android:contentDescription="@null"
        android:src="@mipmap/ic_launcher_foreground" />

    <TextView android:id="@+id/w_brand"
        android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
        android:textSize="13sp" android:textStyle="bold" android:textColor="#3E3A39"
        android:letterSpacing="0.08"
        android:text="NEKO DESK" />
</LinearLayout>
