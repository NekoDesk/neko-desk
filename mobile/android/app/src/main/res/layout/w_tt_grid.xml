<?xml version="1.0" encoding="utf-8"?>
<!-- 위젯 안 시간표 격자. 머리줄과 시간줄을 코드에서 붙인다. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView android:id="@+id/w_tt_title"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textSize="12sp" android:textColor="#3E3A39"
        android:paddingLeft="3dp" android:paddingBottom="5dp" android:text="" />

    <!-- 둥근 틀. 안쪽 여백만큼 테두리가 드러나 네 면이 같은 굵기로 보인다. -->
    <LinearLayout android:id="@+id/w_tt_frame"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="1.2dp"
        android:background="@drawable/w_tt_frame">

        <!-- 시간표는 코드에서 그림으로 그려 넣는다. 칸 높이를 분 단위로 잡으려면
             RemoteViews 로는 안 되고(칸마다 높이를 정할 방법이 없다) 직접 그려야 한다. -->
        <ImageView android:id="@+id/w_tt_img"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:adjustViewBounds="true" android:scaleType="fitXY"
            android:contentDescription="@null" android:visibility="gone" />

        <LinearLayout android:id="@+id/w_tt_head"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:background="@drawable/w_tt_headbg" />

        <LinearLayout android:id="@+id/w_tt_body"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" />
    </LinearLayout>
</LinearLayout>
