<?xml version="1.0" encoding="utf-8"?>
<!-- 위젯 안 시간표 격자. 머리줄과 시간줄을 코드에서 붙인다. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView android:id="@+id/w_tt_title"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textSize="12sp" android:textColor="#3E3A39"
        android:paddingLeft="3dp" android:paddingBottom="5dp" android:text="" />

    <!-- 둥근 틀 — 위아래 테두리가 여기서 그려진다 -->
    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/w_tt_frame">

        <LinearLayout android:id="@+id/w_tt_head"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:background="@drawable/w_tt_headbg" />

        <LinearLayout android:id="@+id/w_tt_body"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" />
    </LinearLayout>
</LinearLayout>
