<?xml version="1.0" encoding="utf-8"?>
<!-- 위젯 안 시간표 격자. 머리줄과 시간줄을 코드에서 붙인다. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView android:id="@+id/w_tt_title"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textSize="11sp" android:textColor="#9AA0A6"
        android:paddingLeft="2dp" android:paddingBottom="4dp" android:text="" />

    <LinearLayout android:id="@+id/w_tt_head"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:background="@drawable/w_tt_headbg" />

    <LinearLayout android:id="@+id/w_tt_body"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" />
</LinearLayout>
