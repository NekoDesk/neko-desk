<?xml version="1.0" encoding="utf-8"?>
<!--
  위젯을 고르는 화면에서만 쓰는 예시 그림.
  진짜 위젯은 코드에서 내용을 채우는데, 고르는 화면에서는 코드가 돌지 않아
  빈 카드로만 보인다. 그래서 예시 내용을 글자로 박아 둔 판을 따로 만든다.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@drawable/w_bg"
    android:padding="10dp">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:layout_marginBottom="8dp">
        <ImageView android:layout_width="26dp" android:layout_height="26dp"
            android:layout_marginEnd="8dp" android:contentDescription="@null"
            android:src="@mipmap/ic_launcher_foreground" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:textSize="13sp" android:textStyle="bold" android:textColor="#3E3A39"
            android:letterSpacing="0.08" android:text="NEKO DESK" />
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:paddingLeft="3dp" android:paddingRight="4dp" android:paddingTop="3dp"
        android:layout_marginBottom="6dp">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:textSize="12sp" android:textColor="#3E3A39" android:text="오늘 할 일" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textSize="10sp" android:textColor="#9AA0A6" android:text="1 / 3 완료" />
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:background="@drawable/w_row_done_bg"
        android:paddingLeft="10dp" android:paddingRight="8dp"
        android:paddingTop="9dp" android:paddingBottom="9dp" android:layout_marginBottom="5dp">
        <TextView android:layout_width="18dp" android:layout_height="18dp"
            android:background="@drawable/w_check_on" android:gravity="center"
            android:textSize="11sp" android:textColor="#FFFFFF" android:includeFontPadding="false"
            android:layout_marginEnd="9dp" android:text="✓" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:textSize="12sp" android:textColor="#9AA0A6" android:maxLines="1"
            android:ellipsize="end" android:text="A사 시안 전달" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:background="@drawable/w_pill_am"
            android:paddingLeft="7dp" android:paddingRight="7dp"
            android:paddingTop="2dp" android:paddingBottom="2dp" android:layout_marginStart="6dp"
            android:textSize="9sp" android:textColor="#5B8DD9" android:text="오전" />
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:background="@drawable/w_row_bg"
        android:paddingLeft="10dp" android:paddingRight="8dp"
        android:paddingTop="9dp" android:paddingBottom="9dp" android:layout_marginBottom="5dp">
        <TextView android:layout_width="18dp" android:layout_height="18dp"
            android:background="@drawable/w_check_off" android:gravity="center"
            android:textSize="11sp" android:textColor="#FFFFFF" android:includeFontPadding="false"
            android:layout_marginEnd="9dp" android:text="" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:textSize="12sp" android:textColor="#3E3A39" android:maxLines="1"
            android:ellipsize="end" android:text="B사 견적서 검토" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:background="@drawable/w_pill_am"
            android:paddingLeft="7dp" android:paddingRight="7dp"
            android:paddingTop="2dp" android:paddingBottom="2dp" android:layout_marginStart="6dp"
            android:textSize="9sp" android:textColor="#5B8DD9" android:text="오전" />
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:background="@drawable/w_row_bg"
        android:paddingLeft="10dp" android:paddingRight="8dp"
        android:paddingTop="9dp" android:paddingBottom="9dp" android:layout_marginBottom="5dp">
        <TextView android:layout_width="18dp" android:layout_height="18dp"
            android:background="@drawable/w_check_off" android:gravity="center"
            android:textSize="11sp" android:textColor="#FFFFFF" android:includeFontPadding="false"
            android:layout_marginEnd="9dp" android:text="" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:textSize="12sp" android:textColor="#3E3A39" android:maxLines="1"
            android:ellipsize="end" android:text="C사 미팅 준비" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:background="@drawable/w_pill_pm"
            android:paddingLeft="7dp" android:paddingRight="7dp"
            android:paddingTop="2dp" android:paddingBottom="2dp" android:layout_marginStart="6dp"
            android:textSize="9sp" android:textColor="#E09A4B" android:text="오후" />
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:background="@drawable/w_row_bg"
        android:paddingLeft="10dp" android:paddingRight="8dp"
        android:paddingTop="9dp" android:paddingBottom="9dp" android:layout_marginBottom="5dp">
        <TextView android:layout_width="18dp" android:layout_height="18dp"
            android:background="@drawable/w_check_off" android:gravity="center"
            android:textSize="11sp" android:textColor="#FFFFFF" android:includeFontPadding="false"
            android:layout_marginEnd="9dp" android:text="" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:textSize="12sp" android:textColor="#3E3A39" android:maxLines="1"
            android:ellipsize="end" android:text="D사 인보이스 발행" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:background="@drawable/w_pill_pm"
            android:paddingLeft="7dp" android:paddingRight="7dp"
            android:paddingTop="2dp" android:paddingBottom="2dp" android:layout_marginStart="6dp"
            android:textSize="9sp" android:textColor="#E09A4B" android:text="오후" />
    </LinearLayout>
</LinearLayout>
