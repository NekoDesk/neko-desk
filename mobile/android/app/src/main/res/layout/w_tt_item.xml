<?xml version="1.0" encoding="utf-8"?>
<!-- 오늘 시간표 한 줄 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingTop="3dp"
    android:paddingBottom="3dp">

    <TextView android:id="@+id/i_time"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textSize="10sp" android:textColor="#5B8DD9"
        android:layout_marginEnd="8dp" android:text="" />

    <TextView android:id="@+id/i_text"
        android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
        android:textSize="11sp" android:textColor="#3E3A39"
        android:maxLines="1" android:ellipsize="end" android:text="" />
</LinearLayout>
