<?xml version="1.0" encoding="utf-8"?>
<!-- 목록 + 오늘 시간표 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/w_bg"
    android:padding="10dp">

    <include layout="@layout/w_header" />
    <include layout="@layout/w_health" />

    <LinearLayout android:id="@+id/w_dday_list"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:layout_marginBottom="3dp" />

    <LinearLayout android:id="@+id/w_head_box"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:paddingLeft="3dp" android:paddingRight="4dp" android:paddingTop="3dp"
        android:layout_marginBottom="6dp">
        <TextView android:id="@+id/w_head_title"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:textSize="12sp" android:textColor="#3E3A39" android:maxLines="1"
            android:ellipsize="end" android:text="" />
        <TextView android:id="@+id/w_head_count"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textSize="10sp" android:textColor="#9AA0A6" android:text="" />
    </LinearLayout>

    <LinearLayout android:id="@+id/w_today_list"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" />

    <TextView android:id="@+id/w_empty"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center" android:paddingTop="12dp" android:paddingBottom="12dp"
        android:textSize="11sp" android:textColor="#9AA0A6" android:text="" />

    <TextView android:id="@+id/w_tt_title"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textSize="11sp" android:textColor="#9AA0A6"
        android:paddingLeft="3dp" android:paddingTop="4dp" android:paddingBottom="4dp"
        android:text="" />
    <LinearLayout android:id="@+id/w_tt_list"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" />
</LinearLayout>
