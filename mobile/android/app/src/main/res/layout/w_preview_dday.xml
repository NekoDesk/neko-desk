<?xml version="1.0" encoding="utf-8"?>
<!--
  위젯을 고르는 화면에서만 쓰는 예시 그림.
  진짜 위젯은 코드에서 내용을 채우는데, 고르는 화면에서는 코드가 돌지 않아
  빈 카드로만 보인다. 그래서 예시 내용을 글자로 박아 둔 판을 따로 만든다.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@drawable/w_bg"
    android:padding="10dp">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:layout_marginBottom="8dp">
        <ImageView android:layout_width="26dp" android:layout_height="26dp"
            android:layout_marginEnd="8dp" android:contentDescription="@null"
            android:src="@mipmap/ic_launcher_foreground" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:textSize="13sp" android:textStyle="bold" android:textColor="#3E3A39"
            android:letterSpacing="0.08" android:text="NEKO DESK" />
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:background="@drawable/w_dday_bg"
        android:paddingLeft="10dp" android:paddingRight="10dp"
        android:paddingTop="8dp" android:paddingBottom="8dp" android:layout_marginBottom="5dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textSize="14sp" android:textStyle="bold" android:textColor="#E4665F"
            android:layout_marginEnd="9dp" android:text="D-3" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:textSize="12sp" android:textColor="#3E3A39" android:maxLines="1"
            android:ellipsize="end" android:text="A사 납품일" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textSize="10sp" android:textColor="#E88C86"
            android:layout_marginStart="6dp" android:text="08.30" />
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:background="@drawable/w_dday_bg"
        android:paddingLeft="10dp" android:paddingRight="10dp"
        android:paddingTop="8dp" android:paddingBottom="8dp" android:layout_marginBottom="5dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textSize="14sp" android:textStyle="bold" android:textColor="#E4665F"
            android:layout_marginEnd="9dp" android:text="D-12" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:textSize="12sp" android:textColor="#3E3A39" android:maxLines="1"
            android:ellipsize="end" android:text="B사 계약 만료" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textSize="10sp" android:textColor="#E88C86"
            android:layout_marginStart="6dp" android:text="09.08" />
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:background="@drawable/w_dday_bg"
        android:paddingLeft="10dp" android:paddingRight="10dp"
        android:paddingTop="8dp" android:paddingBottom="8dp" android:layout_marginBottom="5dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textSize="14sp" android:textStyle="bold" android:textColor="#E4665F"
            android:layout_marginEnd="9dp" android:text="D-24" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:textSize="12sp" android:textColor="#3E3A39" android:maxLines="1"
            android:ellipsize="end" android:text="여름 휴가" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textSize="10sp" android:textColor="#E88C86"
            android:layout_marginStart="6dp" android:text="09.20" />
    </LinearLayout>
</LinearLayout>
