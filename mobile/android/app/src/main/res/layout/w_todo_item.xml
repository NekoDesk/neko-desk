<?xml version="1.0" encoding="utf-8"?>
<!-- 오늘 할 일 한 줄 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/i_row"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/w_row_bg"
    android:paddingLeft="4dp"
    android:paddingRight="8dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp"
    android:layout_marginBottom="5dp">

    <!-- 높이를 체크칸에 맞춰 D-day 줄과 같은 크기가 되게 한다 (36dp였을 때 줄이 더 높았다) -->
    <FrameLayout android:id="@+id/i_chk_area"
        android:layout_width="32dp" android:layout_height="wrap_content"
        android:gravity="center">
        <TextView android:id="@+id/i_chk"
            android:layout_width="18dp" android:layout_height="18dp"
            android:layout_gravity="center"
            android:background="@drawable/w_check_off" android:gravity="center"
            android:textSize="11sp" android:textColor="#FFFFFF"
            android:includeFontPadding="false" android:text="" />
    </FrameLayout>

    <TextView android:id="@+id/i_text"
        android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
        android:textSize="12sp" android:textColor="#3E3A39"
        android:maxLines="1" android:ellipsize="end" android:text="" />

    <TextView android:id="@+id/i_badge"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:background="@drawable/w_pill_am"
        android:paddingLeft="7dp" android:paddingRight="7dp"
        android:paddingTop="2dp" android:paddingBottom="2dp"
        android:layout_marginStart="6dp"
        android:textSize="9sp" android:textColor="#5B8DD9" android:text="" />
</LinearLayout>
